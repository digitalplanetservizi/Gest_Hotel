{
  "name": "hotel-tempio-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build && node scripts/verify-build.mjs",
    "check": "tsc --noEmit -p tsconfig.app.json",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"*.json\" \"*.yaml\" \"tests/*.mjs\""
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "postcss": "8.5.6",
    "prettier": "3.8.4",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.2"
  }
}
